6b\u57fa\u3065\u3044\u305f\u8981\u7d04\u3084Q&amp;A\u3092\u4f5c\u6210\u3059\u308b\u624b\u6cd5\u3092\u7fd2\u5f97\u3057\u307e\u3059\u3002</p>"},{"location":"training/#2-20","title":"2. \u3010\u30ea\u30b9\u30af\u3068\u502b\u7406\u3011\u5b89\u5fc3\u3057\u3066\u696d\u52d9\u306b\u5c0e\u5165\u3059\u308b\u305f\u3081\u306e\u30ea\u30c6\u30e9\u30b7\u30fc\uff0820\u5206\uff09","text":"<ul> <li>\u8457\u4f5c\u6a29\u3068\u5546\u696d\u5229\u7528\u306e\u5883\u754c\u7dda\uff1a SNS\u3084\u30c1\u30e9\u30b7\u3001\u30a4\u30d9\u30f3\u30c8\u3067\u306eAI\u751f\u6210\u7269\uff08\u753b\u50cf\u30fb\u97f3\u697d\uff09\u306e\u4f7f\u7528\u306b\u95a2\u3059\u308b\u5224\u65ad\u57fa\u6e96\u3092\u6574\u7406\u3057\u307e\u3059\u3002</li> <li>\u6700\u65b0\u306e\u898f\u5236\u52d5\u5411\uff1a \u3053\u306e1\u5e74\u3067\u5909\u5316\u3057\u305f\u6cd5\u7684\u72b6\u6cc1\u3084\u3001\u30c7\u30a3\u30fc\u30d7\u30d5\u30a7\u30a4\u30af\u306a\u3069\u306e\u793e\u4f1a\u554f\u984c\u3078\u306e\u5bfe\u5fdc\u529b\u3092\u990a\u3044\u307e\u3059\u3002</li> </ul>"},{"location":"training/#3-1gems30","title":"3. \u3010\u5b9f\u8df5\u2460\u3011Gems\u3068\u6700\u9069\u5316\u30c4\u30fc\u30eb\u306b\u3088\u308b\u4e8b\u52d9\u306e\u81ea\u52d5\u5316\uff0830\u5206\uff09","text":"<ul> <li>\u30ab\u30b9\u30bf\u30e0AI\u300cGems\u300d\u306e\u69cb\u7bc9\uff1a \u4f1a\u8b70\u9332\u8981\u7d04\u3084\u516c\u7684\u6587\u66f8\u4f5c\u6210\u306a\u3069\u3001\u7279\u5b9a\u306e\u30d5\u30ec\u30fc\u30e0\u30ef\u30fc\u30af\uff08\u4f8b\uff1a\u30b7\u30c3\u30af\u30b9\u30fb\u30b7\u30f3\u30ad\u30f3\u30b0\u30fb\u30cf\u30c3\u30c8\u6cd5\uff09\u306b\u5f93\u3063\u3066\u52d5\u304f\u300c\u81ea\u5206\u5c02\u7528\u306e\u526f\u62c5\u5f53\u8005\u300d\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002</li> <li>NotebookLM\u3068\u306e\u9023\u643a\uff1a NotebookLM\u306e\u77e5\u8b58\u30d9\u30fc\u30b9\u3092Gems\u306b\u8aad\u307f\u8fbc\u307e\u305b\u3001\u81ea\u793e\u306e\u30de\u30cb\u30e5\u30a2\u30eb\u3084\u904e\u53bb\u4e8b\u4f8b\u306b\u7cbe\u901a\u3057\u305f\u300c\u6559\u80b2\u7528\u30c1\u30e3\u30c3\u30c8\u30dc\u30c3\u30c8\u300d\u3084\u300c\u4e8b\u4f8b\u691c\u7d22AI\u300d\u3092\u4f5c\u308b\u9ad8\u5ea6\u306a\u6d3b\u7528\u6cd5\u3092\u4f53\u9a13\u3057\u307e\u3059\u3002</li> <li>\u30d7\u30ed\u30f3\u30d7\u30c8\u6700\u9069\u5316\uff1a OpenAI\u516c\u5f0f\u306e\u6700\u9069\u5316\u30c4\u30fc\u30eb\u3092\u7d39\u4ecb\u3057\u3001\u8ab0\u3067\u3082\u9ad8\u54c1\u8cea\u306a\u6307\u793a\u6587\u3092\u4f5c\u6210\u3067\u304d\u308b\u6642\u77ed\u8853\u3092\u4f1d\u6388\u3057\u307e\u3059\uff08\u30bd\u30fc\u30b9\u5916\u60c5\u5831\uff09\u3002</li> </ul>"},{"location":"training/#4-2suno-ai25","title":"4. \u3010\u5b9f\u8df5\u2461\u3011Suno AI\u3067\u300c\u5730\u57df\u306e\u30a4\u30e1\u30fc\u30b8\u30bd\u30f3\u30b0\u300d\u3092\u4f5c\u6210\uff0825\u5206\uff09","text":"<p>\u97f3\u697d\u751f\u6210AI\u3092\u6d3b\u7528\u3057\u3001\u30a4\u30d9\u30f3\u30c8\u3084\u5e83\u5831\u306e\u8cea\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002 *   \u7c21\u5358\u3059\u304e\u308b\u97f3\u697d\u5236\u4f5c\uff1a \u7c21\u5358\u306a\u30d7\u30ed\u30f3\u30d7\u30c8\uff08\u4f8b\uff1a\u300c\u30af\u30ea\u30b9\u30de\u30b9\u3092\u30a4\u30e1\u30fc\u30b8\u300d\uff09\u3092\u5165\u529b\u3059\u308b\u3060\u3051\u3067\u3001\u7d042\u5206\u3067\u672c\u683c\u7684\u306a\u6b4c\u4ed8\u304d\u306e\u66f2\u3092\u751f\u6210\u3059\u308b\u4f53\u9a13\u3092\u3057\u307e\u3059\u3002 *   \u30ab\u30b9\u30bf\u30e0\u30e2\u30fc\u30c9\u3067\u30aa\u30ea\u30b8\u30ca\u30eb\u6b4c\u8a5e\u3092\u53cd\u6620\uff1a \u5730\u57df\u306e\u30b9\u30ed\u30fc\u30ac\u30f3\u3084\u6d3b\u52d5\u5185\u5bb9\u3092\u6b4c\u8a5e\u3068\u3057\u3066\u5165\u529b\u3057\u3001AI\u306b\u4f5c\u66f2\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u72ec\u81ea\u306e\u30a4\u30e1\u30fc\u30b8\u30bd\u30f3\u30b0\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002 *   \u97f3\u304b\u3089\u97f3\u697d\u3092\u4f5c\u308b\uff08Audio-to-Music\uff09\uff1a \u9332\u97f3\u3057\u305f\u74b0\u5883\u97f3\u3084\u30e1\u30ed\u30c7\u30a3\u3092\u5143\u306b\u3001\u65b0\u3057\u3044\u97f3\u697d\u3068\u3057\u3066\u30ab\u30d0\u30fc\u3057\u305f\u308a\u62e1\u5f35\u3057\u305f\u308a\u3059\u308b\u9a5a\u304d\u306e\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002 *   \u5546\u696d\u5229\u7528\u3068\u6d3b\u7528\u30b7\u30fc\u30f3\uff1a \u6709\u6599\u30d7\u30e9\u30f3\u306b\u3088\u308b\u5546\u696d\u5229\u7528\u306e\u30eb\u30fc\u30eb\u3092\u78ba\u8a8d\u3057\u3001\u30a4\u30d9\u30f3\u30c8BGM\u3084YouTube\u52d5\u753b\u306e\u80cc\u666f\u97f3\u697d\u3068\u3057\u3066\u306e\u6d3b\u7528\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002</p>"},{"location":"training/#5-3nano-banana-pro25","title":"5. \u3010\u5b9f\u8df5\u2462\u3011Nano Banana Pro\u306b\u3088\u308b\u8996\u899a\u7684\u5e83\u5831\u306e\u9769\u65b0\uff0825\u5206\uff09","text":"<ul> <li>\u6587\u5b57\u304c\u6b63\u78ba\u306b\u51fa\u308b\u753b\u50cf\u751f\u6210\uff1a \u5f93\u6765\u306e\u5f31\u70b9\u3092\u514b\u670d\u3057\u3001\u6b63\u78ba\u306a\u30c6\u30ad\u30b9\u30c8\u3092\u542b\u3081\u305f\u30c1\u30e9\u30b7\u3084\u30a4\u30f3\u30d5\u30a9\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3092\u4f5c\u6210\u3067\u304d\u308b\u300cNano Banana Pro\uff08Gemini 3 Pro Image\uff09\u300d\u3092\u4f53\u9a13\u3057\u307e\u3059\u3002</li> <li>\u30de\u30f3\u30ac\u5f62\u5f0f\u306e\u5e83\u5831\uff1a \u96e3\u3057\u3044\u798f\u7949\u306e\u8a71\u984c\u3092\u300c\u53f0\u8a5e\u5165\u308a\u306e\u6f2b\u753b\u300d\u3078\u5909\u63db\u3057\u3001\u89aa\u3057\u307f\u3084\u3059\u3044\u5e83\u5831\u7269\u3092\u4f5c\u308b\u30d7\u30ed\u30f3\u30d7\u30c8\u3092\u7fd2\u5f97\u3057\u307e\u3059\u3002</li> <li>\u4e00\u8cab\u6027\u306e\u3042\u308b\u30c7\u30b6\u30a4\u30f3\uff1a \u7279\u5b9a\u306e\u753b\u98a8\u3092\u7dad\u6301\u3057\u305f\u307e\u307e\u3001\u8907\u6570\u306e\u5e83\u5831\u753b\u50cf\u3092\u91cf\u7523\u3059\u308b\u30c6\u30af\u30cb\u30c3\u30af\u3092\u5b66\u3073\u307e\u3059\u3002</li> </ul>"},{"location":"training/#6-qa15","title":"6. \u3010\u7dcf\u62ec\u30fbQ&amp;A\u3011\u5730\u57df\u6d3b\u52d5\u306e\u672a\u6765\u3068\u8cea\u7591\u5fdc\u7b54\uff0815\u5206\uff09","text":"<ul> <li>\u500b\u5225\u8ab2\u984c\u76f8\u8ac7\uff1a \u30dc\u30e9\u30f3\u30c6\u30a3\u30a2\u306e\u4e16\u4ee3\u4ea4\u4ee3\u3084\u53ce\u76ca\u5316\u306a\u3069\u3001\u5730\u57df\u6d3b\u52d5\u306e\u60a9\u307f\u306bAI\u3092\u3069\u3046\u5f79\u7acb\u3066\u308b\u304b\u8b1b\u5e2b\u304c\u76f4\u63a5\u56de\u7b54\u3057\u307e\u3059\u3002</li> </ul> <p>\u305f\u3068\u3048\u8a71\uff1a \u3053\u306e\u30bb\u30df\u30ca\u30fc\u3067\u7686\u3055\u3093\u304c\u624b\u306b\u3059\u308b\u306e\u306f\u3001\u300c\u4f55\u3067\u3082\u899a\u3048\u3066\u3044\u308b\u66f8\u8a18\uff08NotebookLM\uff09\u300d\u300c\u5b9a\u578b\u696d\u52d9\u3092\u3053\u306a\u3059\u4e8b\u52d9\u54e1\uff08Gems\uff09\u300d\u300c\u611f\u52d5\u7684\u306a\u66f2\u3092\u66f8\u304f\u4f5c\u66f2\u5bb6\uff08Suno AI\uff09\u300d\u300c\u5206\u304b\u308a\u3084\u3059\u3044\u7d75\u3092\u63cf\u304f\u7d75\u5e2b\uff08Nano Banana Pro\uff09\u300d\u304c\u63c3\u3063\u305f\u3001\u4e00\u3064\u306e\u5f37\u529b\u306a\u300eAI\u4e8b\u52d9\u5c40\u300f\u3067\u3059\u3002\u7686\u3055\u3093\u306f\u305d\u306e\u30c1\u30fc\u30e0\u306e\u30ea\u30fc\u30c0\u30fc\u3068\u3057\u3066\u3001\u3069\u306e\u4ef2\u9593\u306b\u3069\u306e\u4ed5\u4e8b\u3092\u4efb\u305b\u308b\u304b\u3092\u6c7a\u3081\u308b\u3060\u3051\u3067\u3001\u6d3b\u52d5\u306e\u5e45\u3092\u4f55\u500d\u306b\u3082\u5e83\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002</p>"},{"location":"guide/getting-started/","title":"\u4f7f\u3044\u59cb\u3081\u308b","text":""},{"location":"guide/getting-started/#_2","title":"\u30da\u30fc\u30b8\u69cb\u6210\uff08\u304a\u3059\u3059\u3081\uff09","text":"<ul> <li>\u76ee\u7684\uff08Goal\uff09</li> <li>\u524d\u63d0\uff08Prerequisites\uff09</li> <li>\u624b\u9806\uff08Steps\uff09</li> <li>\u671f\u5f85\u3055\u308c\u308b\u7d50\u679c\uff08Expected output\uff09</li> <li>\u3088\u304f\u3042\u308b\u30a8\u30e9\u30fc\uff08Troubleshooting\uff09</li> </ul>"},{"location":"guide/getting-started/#_3","title":"\u7ae0\u306e\u8ffd\u52a0\u65b9\u6cd5","text":"<ol> <li><code>docs/guide/</code> \u306a\u3069\u306b <code>*.md</code> \u3092\u8ffd\u52a0</li> <li><code>mkdocs.yml</code> \u306e <code>nav:</code> \u306b\u8ffd\u52a0\uff08\u30b5\u30a4\u30c9\u30d0\u30fc\u306e\u9806\u5e8f\u304c\u6c7a\u307e\u308a\u307e\u3059\uff09</li> </ol> <p>\u4f8b:</p> <pre><code>nav:\n  - \u30ac\u30a4\u30c9:\n      - \u65b0\u3057\u3044\u7ae0: guide/new-chapter.md\n</code></pre>"},{"location":"guide/images/","title":"\u753b\u50cf\u306e\u6271\u3044","text":""},{"location":"guide/images/#_2","title":"\u7f6e\u304d\u5834\u6240","text":"<p>\u753b\u50cf\u306f <code>docs/assets/images/</code> \u306b\u7f6e\u304d\u307e\u3059\u3002</p> <p>\u4f8b: - <code>docs/assets/images/login.png</code> - <code>docs/assets/images/step-01.png</code></p>"},{"location":"guide/images/#markdown","title":"Markdown \u304b\u3089\u53c2\u7167\u3059\u308b","text":"<p>\u540c\u4e00\u968e\u5c64\u306e\u30da\u30fc\u30b8\u304b\u3089\u53c2\u7167\u3059\u308b\u4f8b:</p> <pre><code>![](assets/images/step-01.png)\n</code></pre> <p><code>docs/guide/</code> \u914d\u4e0b\u306e\u30da\u30fc\u30b8\u304b\u3089\u53c2\u7167\u3059\u308b\u4f8b:</p> <pre><code>![](../assets/images/step-01.png)\n</code></pre>"},{"location":"guide/images/#_3","title":"\u547d\u540d\u30eb\u30fc\u30eb\uff08\u304a\u3059\u3059\u3081\uff09","text":"<ul> <li>\u5c0f\u6587\u5b57 + \u30cf\u30a4\u30d5\u30f3\u533a\u5207\u308a: <code>step-01.png</code></li> <li>\u624b\u9806\u756a\u53f7\u3092\u5165\u308c\u308b\uff08\u4e26\u3073\u66ff\u3048\u306b\u5f37\u304f\u3059\u308b\uff09: <code>setup-01.png</code>, <code>setup-02.png</code></li> </ul>"},{"location":"guide/publishing/","title":"\u516c\u958b\uff08GitHub Pages\uff09","text":"<p>\u3053\u306e\u30b5\u30a4\u30c8\u306f GitHub Actions \u3067 MkDocs \u3092\u30d3\u30eb\u30c9\u3057\u3001GitHub Pages \u306b\u30c7\u30d7\u30ed\u30a4\u3057\u307e\u3059\u3002</p>"},{"location":"guide/publishing/#1","title":"1) \u30ea\u30dd\u30b8\u30c8\u30ea\u8a2d\u5b9a","text":"<p>GitHub \u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u753b\u9762\u3067\u4ee5\u4e0b\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002 - <code>Settings</code> \u2192 <code>Pages</code> - <code>Build and deployment</code> \u2192 <code>Source</code>: <code>GitHub Actions</code></p>"},{"location":"guide/publishing/#2-url","title":"2) \u516c\u958bURL\uff08\u88dc\u8db3\uff09","text":"<p>\u516c\u958bURL\u306f\u901a\u5e38 <code>https://&lt;org-or-user&gt;.github.io/&lt;repo&gt;/</code> \u306b\u306a\u308a\u307e\u3059\u3002</p> <p><code>mkdocs.yml</code> \u306e <code>site_url</code> \u306f\u3053\u306eURL\u306b\u5408\u308f\u305b\u3066\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\uff08\u4f8b: <code>https://example.github.io/mie20260113/</code>\uff09\u3002</p>"},{"location":"guide/publishing/#3","title":"3) \u516c\u958b\u306e\u30c8\u30ea\u30ac\u30fc","text":"<p><code>main</code> \u30d6\u30e9\u30f3\u30c1\u3078 push \u3059\u308b\u3068\u3001<code>.github/workflows/deploy-pages.yml</code> \u304c\u8d70\u3063\u3066\u81ea\u52d5\u516c\u958b\u3055\u308c\u307e\u3059\u3002</p>"}]}